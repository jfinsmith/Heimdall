rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// HEIMDALL Firestore security rules — enforces the §4 RBAC matrix AND pooled
// multi-tenant isolation (Phase 5 cutover).
//
// Roles ride on a custom auth claim (request.auth.token.role); the tenant rides
// on request.auth.token.orgId (minted by the admin callables + the org backfill).
// Chain of command: instructor → coordinator → sergeant → lieutenant → director.
//
// TENANT ISOLATION: every org-owned doc carries an `orgId` field, and a caller
// may only touch docs whose orgId matches their own claim (inOrg). Reads/lists
// therefore REQUIRE the client query to be orgId-constrained (centralized in
// useCollection); creates must stamp the caller's orgId; orgId is immutable on
// update. A caller whose token lacks an orgId claim matches nothing — the
// AuthContext force-refresh mints the claim into the live token at sign-in so a
// freshly-backfilled session isn't locked out.
//
// Known rules-language limits, mitigated in code:
//  • roleSlots[].filledBy.length <= count — enforced in the sign-up transaction.
//  • qualifications[].verified (array of maps) — gated via the flat
//    verifiedQualKeys array, which self-edits must keep unchanged.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return signedIn() && 'role' in request.auth.token ? request.auth.token.role : 'instructor';
    }
    // Defense-in-depth: a suspended/deactivated user's FUTURE tokens carry a
    // status claim (minted by setUserSuspension/setUserActive, which also strip
    // the role claim + revoke refresh tokens). Absent claim = active.
    // 'pending' is minted WITH the orgId claim when an account joins an org
    // (join code, domain auto-join, owner assignment) and is dropped when an
    // admin approves it (setUserRole rebuilds the claims). Without it a
    // not-yet-approved joiner — whose role-less token role() reads as
    // 'instructor' — could read the org's schedule, sign-ups, rooms and settings
    // while the app merely parked them on the /pending screen.
    function activeStatus() {
      return !(request.auth.token.get('status', 'active') in ['suspended', 'inactive', 'pending']);
    }
    // Coordinator and above: may build schedules, approve sign-ups, verify quals.
    function isStaff() {
      return signedIn() && activeStatus() && role() in ['director', 'lieutenant', 'sergeant', 'coordinator'];
    }
    // Command: may manage users, roles, and org settings. Sergeant and above —
    // MUST match ADMIN_ROLES in src/types and functions/src/types.
    function isAdmin() {
      return signedIn() && activeStatus() && role() in ['director', 'lieutenant', 'sergeant'];
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }
    // ── Tenant helpers ──────────────────────────────────────────────────────
    // The caller's tenant from their custom claim (null if unsigned/unassigned).
    function tokenOrgId() {
      return signedIn() ? request.auth.token.get('orgId', null) : null;
    }
    function isPlatformOwner() {
      return signedIn() && request.auth.token.get('platformOwner', false) == true;
    }
    // A doc belongs to the caller's tenant. Requires the caller to HAVE an org
    // claim, so an orgless/stale token can't read orgless docs as a back door.
    // activeStatus(): suspension/deactivation strips the ROLE claim but keeps the
    // orgId claim (and the login is not disabled), so without it a locked-out
    // member could sign in again and still read the org's schedule, rooms and
    // sign-ups as a default 'instructor'. Token-only check — list-query safe.
    function inOrg(data) {
      return tokenOrgId() != null && activeStatus() && data.get('orgId', null) == tokenOrgId();
    }
    // A class may be published only after the captain's approval. Templates are
    // exempt. (Repeated get() on the same path is cached → one read.)
    function academyOkToPublish(aid) {
      return get(/databases/$(database)/documents/academies/$(aid)).data.get('isTemplate', false) == true
          || get(/databases/$(database)/documents/academies/$(aid)).data.get(['approval', 'state'], '') == 'approved';
    }
    // The academy `aid` exists and belongs to the caller's tenant. A child doc's
    // OWN orgId stamp is caller-supplied, so on its own it never proved the
    // PARENT was theirs: staff of org A could create docs under (or sessions
    // pointing at) org B's academy — a private/portal doc with their own token
    // that the public-portal callable then honours, planted roster rows, a
    // squatted attendance/limbo doc, or sessions on B's public class page.
    // Used on CREATE only. Every write in a batch names the same academy, so
    // this is one cached read (same pattern as academyOkToPublish).
    function academyInOrg(aid) {
      return get(/databases/$(database)/documents/academies/$(aid)).data.get('orgId', null) == tokenOrgId();
    }

    // ── orgs (tenant registry) ───────────────────────────────────────────────
    // Read your own org; the platform owner reads all (owner console). Writes are
    // the createOrg callable (Admin SDK) only.
    match /orgs/{orgId} {
      allow read: if signedIn() && activeStatus() && (orgId == tokenOrgId() || isPlatformOwner());
      allow write: if false;
    }

    // ── users ──────────────────────────────────────────────────────────────
    // Own doc: read + create + limited update. Staff read/manage SAME-TENANT
    // users only. role / status / verifiedQualKeys are admin-or-staff-set; orgId
    // / platformOwner are server-managed (Admin SDK). A freshly self-registered
    // user has no orgId yet and is reachable only by themselves until an admin
    // assigns a role (setUserRole stamps the admin's org); surfacing such pending
    // cross-org registrations to the right admin is Phase-6 (multi-tenant sign-in).
    match /users/{uid} {
      allow read: if isOwner(uid) || (isStaff() && inOrg(resource.data));
      allow create: if isOwner(uid)
        && request.resource.data.role == 'instructor'
        && request.resource.data.status == 'pending'
        && request.resource.data.verifiedQualKeys == []
        // The profile email MUST be the signed-in identity's email: it is the
        // notify() destination AND what the domain auto-join trigger + admins
        // see. A forged "someone@tenant.edu" on a verified Gmail login would
        // otherwise be routed into that tenant's approval queue as that person.
        && request.resource.data.email is string
        // (A provider token with no email claim — rare — may only create an
        // EMPTY email, never a chosen one.)
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.displayName is string
        && request.resource.data.qualifications is list
        // Tenant + platform claims are server-managed (Admin SDK only) — never
        // self-set, or a self-registrant could pre-seed platformOwner:true and
        // have it minted into a real claim on their first role assignment.
        && !('orgId' in request.resource.data)
        && !('platformOwner' in request.resource.data)
        && !('homeOrgId' in request.resource.data)
        && !('homeRole' in request.resource.data)
        // Same for the code-verified notification address: update blocks these
        // (below), so create must too, or they could be pre-seeded unverified.
        && !('notificationEmail' in request.resource.data)
        && !('notificationEmailVerified' in request.resource.data)
        && !('notificationEmailPending' in request.resource.data);
      // orgId / platformOwner / homeOrgId / homeRole are ONLY written by the Admin
      // SDK (callables + scripts), which bypass these rules. No client update — not
      // even an admin — may change them; the role-minting + owner-switch callables
      // trust the user doc (homeOrgId/homeRole anchor the owner's reversible switch).
      // A member may REMOVE their own verified quals (cert lapsed / no longer
      // holds it) but never ADD — additions still require staff verification.
      // Removal-only = the new set is a subset of the old.
      function verifiedQualsOnlyRemoved() {
        return resource.data.get('verifiedQualKeys', []).toSet()
          .hasAll(request.resource.data.get('verifiedQualKeys', []).toSet());
      }
      allow update: if unchanged('orgId') && unchanged('platformOwner')
        && unchanged('homeOrgId') && unchanged('homeRole')
        // Notification-email fields are written ONLY by the notificationEmail
        // callables (code-verified) — a client write here could forge
        // notificationEmailVerified and route mail to an unproven inbox.
        && unchanged('notificationEmail') && unchanged('notificationEmailVerified')
        && unchanged('notificationEmailPending')
        // role / email / suspension changes go ONLY through their callables
        // (setUserRole / adminUpdateUser / setUserSuspension) — the callables
        // authorize from doc roles, so a direct write here was a ladder bypass
        // (write an accomplice's role), a silent mail redirect (rewrite a
        // member's email, notify()'s destination), or an upward lockout (flip a
        // director's status). The ONE allowed client status write is the
        // pending → active account approval.
        && unchanged('role') && unchanged('email')
        && (unchanged('status')
            || (resource.data.status == 'pending' && request.resource.data.status == 'active')) && (
        // Admins may edit others' profile fields; self-approval AND
        // self-verification stay blocked (an admin adding to their OWN
        // verifiedQualKeys would bypass the staff-verifies-others model).
        (isAdmin() && inOrg(resource.data)
            && (request.auth.uid != uid || (unchanged('status') && verifiedQualsOnlyRemoved())))
        // Staff (coordinator/sergeant) may approve accounts and verify quals on
        // OTHER same-tenant users, but may NOT self-grant their own status /
        // verifiedQualKeys (no self-escalation; removal-only self-edits OK).
        || (isStaff()
            && inOrg(resource.data)
            && (request.auth.uid != uid || (unchanged('status') && verifiedQualsOnlyRemoved())))
        // Self-service: profile fields only (+ removal-only verified quals).
        || (isOwner(uid)
            && unchanged('status')
            && verifiedQualsOnlyRemoved()));
      // NO client deletes — deletion goes through adminDeleteAccount (rank
      // ladder + audit) or the owner's deleteUnassignedAccount. A direct
      // delete let a sergeant orphan a director's login for adoption hijack.
      allow delete: if false;

      // Server-only secrets (e.g. the notification-email verification code
      // hash). NO client access — not even the owner: if a member could read
      // the code they could "verify" an inbox they don't control.
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // ── settings/{orgId} (per-tenant config; doc id == orgId) ────────────────
    // Read/write ONLY your own org's settings doc. (The legacy 'global' doc is no
    // longer client-readable post-cutover; the Admin SDK still reads it server-side.)
    match /settings/{docId} {
      allow read: if signedIn() && activeStatus() && docId == tokenOrgId();
      allow write: if isAdmin() && docId == tokenOrgId();
      // Coordinators manage the Limbo activity dropdown + its colors in place
      // — those fields (plus the timestamp); everything else stays admin-only.
      allow update: if isStaff() && docId == tokenOrgId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['limboActivities', 'limboActivityColors', 'updatedAt']);
    }

    // ── reportConfig/{orgId} (per-tenant report categories + name overrides) ─
    match /reportConfig/{docId} {
      allow read: if signedIn() && activeStatus() && docId == tokenOrgId();
      allow write: if isAdmin() && docId == tokenOrgId();
    }

    // ── feedbackReports (member-submitted bug / feature reports) ────────────
    // A member files their own (stamped with their org); same-org admins triage.
    // (Cross-org owner visibility is a later phase.)
    match /feedbackReports/{id} {
      allow read: if (isAdmin() && inOrg(resource.data)) || isOwner(resource.data.submittedByUid);
      allow create: if signedIn()
        && request.resource.data.submittedByUid == request.auth.uid
        && inOrg(request.resource.data)
        && request.resource.data.status == 'new'
        && request.resource.data.kind in ['bug', 'feature']
        && request.resource.data.title is string
        && request.resource.data.description is string;
      // Client updates are TRIAGE-NOTE-ONLY: status/statusComment/resolvedBy
      // flow through the setFeedbackStatus callable (which also emails the
      // reporter); orgId/submitter fields are immutable (cross-tenant guard).
      allow update: if isAdmin() && inOrg(resource.data)
        && unchanged('orgId') && unchanged('submittedByUid') && unchanged('submittedByEmail')
        && unchanged('status') && unchanged('statusComment') && unchanged('resolvedByUid');
      allow delete: if isAdmin() && inOrg(resource.data);
    }

    // ── courseCatalog ──────────────────────────────────────────────────────
    match /courseCatalog/{courseId} {
      allow read: if signedIn() && inOrg(resource.data);
      allow create: if isStaff() && inOrg(request.resource.data);
      allow update: if isStaff() && inOrg(resource.data) && unchanged('orgId');
      allow delete: if isStaff() && inOrg(resource.data);
    }

    // ── curricula (admin-editable disciplines + minimum hours) ─────────────
    match /curricula/{key} {
      // `resource == null`: useCurriculum() listens to the org copy of a
      // platform program (curricula/{orgId}__{key}) that usually doesn't exist;
      // a denied listener never fires if the copy is created later. Reveals
      // only nonexistence (get only); LIST stays strictly org-scoped.
      allow get: if signedIn() && (resource == null || inOrg(resource.data));
      allow list: if signedIn() && inOrg(resource.data);
      allow create: if isAdmin() && inOrg(request.resource.data);
      allow update: if isAdmin() && inOrg(resource.data) && unchanged('orgId');
      allow delete: if isAdmin() && inOrg(resource.data);
    }

    // ── room reservation: categories + rooms (org-scoped) ─────────────────
    // Schedule-building staff manage them; any signed-in member of the org may
    // read (room pickers + the reservation calendar). orgId is immutable.
    match /roomCategories/{id} {
      allow read: if signedIn() && inOrg(resource.data);
      allow create: if isStaff() && inOrg(request.resource.data);
      allow update: if isStaff() && inOrg(resource.data) && unchanged('orgId');
      allow delete: if isStaff() && inOrg(resource.data);
    }
    match /rooms/{id} {
      allow read: if signedIn() && inOrg(resource.data);
      allow create: if isStaff() && inOrg(request.resource.data);
      allow update: if isStaff() && inOrg(resource.data) && unchanged('orgId');
      allow delete: if isStaff() && inOrg(resource.data);
    }
    match /roomReservations/{id} {
      allow read: if signedIn() && inOrg(resource.data);
      // Writes are SERVER-owned (saveRoomReservation / deleteRoomReservation
      // callables, Admin SDK) so the transactional conflict check can't be
      // bypassed by a direct client write.
      allow write: if false;
    }

    // ── remediation tracker — cadets returning with a later class after a
    //    block failure or injury. STAFF-ONLY INCLUDING READS: these docs hold
    //    injury / workers'-comp and agency-assignment details that instructors
    //    must never see. ──
    match /remediations/{id} {
      allow read: if isStaff() && inOrg(resource.data);
      allow create: if isStaff() && inOrg(request.resource.data);
      allow update: if isStaff() && inOrg(resource.data) && unchanged('orgId');
      allow delete: if isStaff() && inOrg(resource.data);
    }

    // ── defaultCurricula (platform-level FDLE programs) ───────────────────
    // The five owner-managed FDLE programs are the single source of truth shown
    // read-only across EVERY org, so any signed-in user may read them; only the
    // platform owner may write. (No orgId — they belong to the platform.)
    match /defaultCurricula/{key} {
      allow read: if signedIn();
      allow write: if isPlatformOwner();
    }

    // ── documentLibrary (owner-managed forms library) ─────────────────────
    // General forms are readable by any org's staff; specialized forms only by an
    // assigned org. NOT tenant-scoped — only the platform owner may write.
    match /documentLibrary/{id} {
      // The specialized branch uses the canonical array-membership form
      // (`<authValue> in resource.data.field`) directly — not via tokenOrgId() or an
      // `is list` guard — so Firestore can prove the array-contains LIST query safe.
      allow read: if isPlatformOwner()
        || (isStaff() && (resource.data.availability == 'general'
            || request.auth.token.orgId in resource.data.orgIds));
      allow write: if isPlatformOwner();
    }

    // ── documentAssignments (owner-set per-document org availability) ──────
    // documentAssignments/{reportTypeId}: which orgs a registry document is
    // offered to. Absent doc / scope 'all' = every org. Any signed-in user may
    // read (each org's Reports page filters its offering with these); ONLY the
    // platform owner writes.
    match /documentAssignments/{id} {
      // Staff-only read (the Reports offering filter is a staff surface) — a
      // signedIn() read let any member enumerate other tenants' org ids.
      allow read: if isStaff() || isPlatformOwner();
      allow write: if isPlatformOwner();
    }

    // ── documentForms (in-app document builder, Phase 12) ──────────────────
    // Org-scoped admin/owner-authored documents; staff read them to file reports.
    // Writers must be command (or the platform owner) AND in the doc's org — so an
    // owner can only author for the org they're currently switched into.
    match /documentForms/{id} {
      allow read: if (isStaff() || isPlatformOwner()) && inOrg(resource.data);
      allow create: if (isAdmin() || isPlatformOwner()) && inOrg(request.resource.data);
      allow update: if (isAdmin() || isPlatformOwner()) && inOrg(resource.data) && unchanged('orgId');
      allow delete: if (isAdmin() || isPlatformOwner()) && inOrg(resource.data);
    }

    // ── coursePublishEvents ────────────────────────────────────────────────
    match /coursePublishEvents/{id} {
      allow read: if isStaff() && inOrg(resource.data);
      allow create: if isStaff()
        && request.resource.data.requestedBy == request.auth.uid
        && inOrg(request.resource.data);
      allow update, delete: if false;
    }

    // ── academies ──────────────────────────────────────────────────────────
    // Instructors see published lifecycle states only; staff see everything —
    // both within their own tenant. Lists MUST be orgId-constrained (useCollection).
    // Billing gate — mirrors src/lib/subscription.ts. An org may create/publish
    // academies unless commercialization is ON (billingEnabled) and its
    // subscription has lapsed past the grace window. Complimentary + pre-billing
    // orgs always pass (so the founding PHSC beta is never restricted).
    function billingAllows(orgId) {
      let o = get(/databases/$(database)/documents/orgs/$(orgId)).data;
      return o.get('complimentary', false) == true
        || o.get('billingEnabled', false) != true
        || o.get('subscriptionStatus', 'none') in ['active', 'trialing', 'incomplete']
        || (o.get('subscriptionStatus', 'none') in ['past_due', 'unpaid']
            && o.get('currentPeriodEnd', 0) + 259200000 > request.time.toMillis());
    }

    match /academies/{academyId} {
      allow read: if inOrg(resource.data) && (
        isStaff()
        || (signedIn() && resource.data.status in ['published', 'in_progress', 'completed'])
      );
      // New academies must start as un-approved drafts (the approval chain + the
      // academyApproval Admin-SDK callable are the only way to 'approved'); this
      // stops a client creating an already-published/approved class outright.
      allow create: if isStaff() && inOrg(request.resource.data)
        && request.resource.data.status == 'draft'
        && request.resource.data.get(['approval', 'state'], 'not_submitted') != 'approved'
        && billingAllows(request.resource.data.orgId);
      allow delete: if isStaff() && inOrg(resource.data);
      // Staff edit freely within their org, EXCEPT moving into a published
      // lifecycle state, which requires the captain's approval (templates exempt).
      // orgId is immutable. Approval transitions are written by the academyApproval
      // callable (Admin SDK).
      // The publish gate reads the STORED doc (resource.data), never the client
      // payload — otherwise a client could forge approval:{state:'approved'} or
      // isTemplate:true in the same write to self-publish. approval is immutable
      // from clients: only the academyApproval Admin-SDK callable advances it.
      // isTemplate is fixed at create (the app only ever sets it there): it is
      // the exemption from this gate, so a mutable flag was a three-write
      // self-publish — mark a pending draft as a template, publish it (exempt),
      // then clear the flag.
      allow update: if isStaff() && inOrg(resource.data) && unchanged('orgId') && unchanged('approval') && unchanged('isTemplate') && (
        !(request.resource.data.status in ['published', 'in_progress', 'completed'])
        || resource.data.status in ['published', 'in_progress', 'completed']
        || resource.data.get('isTemplate', false) == true
        || (resource.data.get(['approval', 'state'], '') == 'approved' && billingAllows(resource.data.orgId))
      );

      // ── roster (per-academy cadets) ──────────────────────────────────────
      // Same-tenant staff only — holds PII. Encrypted SSN fields are owned by the
      // roster callables (Admin SDK); a client write may not set/alter them.
      match /roster/{memberId} {
        allow read: if isStaff() && inOrg(resource.data);
        allow create: if isStaff()
          && inOrg(request.resource.data)
          && academyInOrg(academyId)
          && !('ssnCipher' in request.resource.data)
          && !('ssnLast4' in request.resource.data);
        allow delete: if isStaff() && inOrg(resource.data);
        allow update: if isStaff()
          && inOrg(resource.data)
          && unchanged('orgId')
          && request.resource.data.get('ssnCipher', '') == resource.data.get('ssnCipher', '')
          && request.resource.data.get('ssnLast4', '') == resource.data.get('ssnLast4', '');
      }

      // ── limbo plan — post-academy day-by-day whereabouts (staff-only) ──
      // `resource == null` lets the tracker SUBSCRIBE before its first save
      // (same dead-listener trap as private/portal below).
      match /limbo/{docId} {
        allow read: if isStaff() && (resource == null || inOrg(resource.data));
        allow create: if isStaff() && inOrg(request.resource.data) && academyInOrg(academyId);
        allow update: if isStaff() && inOrg(resource.data) && unchanged('orgId');
        allow delete: if isStaff() && inOrg(resource.data);
      }

      // ── voluntary attendance log (one doc per day; staff-only, org-scoped) ──
      match /attendance/{date} {
        allow read: if isStaff() && inOrg(resource.data);
        allow create: if isStaff() && inOrg(request.resource.data) && academyInOrg(academyId);
        allow update: if isStaff() && inOrg(resource.data) && unchanged('orgId');
        allow delete: if isStaff() && inOrg(resource.data);
      }

      // ── academic-action reports (cadet exam-failure / dismissal letters) ──
      match /reports/{reportId} {
        allow read: if isStaff() && inOrg(resource.data);
        allow create: if isStaff() && inOrg(request.resource.data) && academyInOrg(academyId);
        allow update: if isStaff() && inOrg(resource.data) && unchanged('orgId');
        allow delete: if isStaff() && inOrg(resource.data);
      }

      // ── portal secrets (public-link token + academic password hash) ──
      // STAFF-ONLY: the parent academy doc is readable by any org member once
      // published, so these must never live there — an instructor could crack
      // the unsalted hash offline and reach the grades tier.
      match /private/{docId} {
        // `resource == null` lets staff SUBSCRIBE to a not-yet-created doc (the
        // builder listens to private/portal before the link exists). Without
        // it, the listen is DENIED, the dead listener never fires after Create
        // writes the doc, and the card only updates on a full page refresh.
        // Reveals only nonexistence, and only to staff.
        allow read: if isStaff() && (resource == null || inOrg(resource.data));
        allow create: if isStaff() && inOrg(request.resource.data) && academyInOrg(academyId);
        allow update: if isStaff() && inOrg(resource.data) && unchanged('orgId');
        allow delete: if isStaff() && inOrg(resource.data);
      }
    }

    // ── sessions ───────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if inOrg(resource.data) && (isStaff() || (signedIn() && resource.data.status != 'draft'));
      // New sessions must be draft unless the parent academy is approved/template
      // (so a session can't be created already-visible to dodge approval).
      // The academy must be the caller's own (academyInOrg): the publish gate
      // alone accepted ANY approved academy id, another tenant's included.
      allow create: if isStaff()
        && inOrg(request.resource.data)
        && request.resource.data.roleSlots is list
        && academyInOrg(request.resource.data.academyId)
        && (request.resource.data.status == 'draft' || academyOkToPublish(request.resource.data.academyId));
      // NOTE: delete is separate — on delete there is no request.resource.
      allow delete: if isStaff() && inOrg(resource.data);
      // Staff-only updates, EXCEPT flipping draft→visible (publishing), which
      // requires the parent academy's approval. orgId immutable. Sign-up/withdraw
      // (roleSlots mutation) is now SERVER-owned (submitSignup/withdrawSignup
      // callables via Admin SDK) — a client may NOT write roleSlots, so a non-staff
      // member can't over-fill a slot, insert other uids, or skip qualification.
      // academyId is immutable (no form ever moves a session): a session may be
      // created already-visible under a TEMPLATE, so re-pointing it afterwards
      // would surface it under a class the captain never approved.
      allow update: if isStaff() && inOrg(resource.data) && unchanged('orgId') && unchanged('academyId') && (
            request.resource.data.status == resource.data.status
            || request.resource.data.status == 'draft'
            || resource.data.status != 'draft'
            || academyOkToPublish(resource.data.academyId)
          );

      // ── signups subcollection ────────────────────────────────────────────
      // Same-tenant. Self sign-up/withdraw is SERVER-owned (submitSignup/
      // withdrawSignup, Admin SDK) — clients no longer write their own signup
      // doc. Staff (reserve flow) still write any; everyone in-org may read.
      match /signups/{uid} {
        allow read: if signedIn() && inOrg(resource.data);
        allow create: if isStaff() && inOrg(request.resource.data);
        allow update: if isStaff() && inOrg(resource.data) && unchanged('orgId');
        allow delete: if isStaff() && inOrg(resource.data);
      }
    }

    // ── assignments ────────────────────────────────────────────────────────
    // Denormalized mirror. Readable by owner + staff, within tenant. Written by
    // the sign-up callables (Admin SDK) and staff (reserve flow) — NOT by a
    // non-staff client (which previously could forge its own schedule entry).
    match /assignments/{assignmentId} {
      allow read: if inOrg(resource.data) && (isStaff() || resource.data.uid == request.auth.uid);
      allow create: if isStaff() && inOrg(request.resource.data);
      allow update: if isStaff() && inOrg(resource.data) && unchanged('orgId');
      allow delete: if isStaff() && inOrg(resource.data);
    }

    // ── notifications ──────────────────────────────────────────────────────
    // Per-recipient (uid is the scope; a user belongs to one tenant). Function-
    // written; owner may read and mark read.
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if false; // Gjallarhorn (Admin SDK) only
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ── mail / mailQueue ───────────────────────────────────────────────────
    // Outgoing email. `mailQueue` is consumed by our sendQueuedEmail function;
    // `mail` is the retired Trigger Email extension's legacy queue (the daily
    // sweep purges old docs from both). SERVER-ONLY, reads included: queued
    // bodies carry temporary passwords (createUserAccount / createOrgAdmin /
    // sendActivationEmail) and notification-email verification codes for 30
    // days, so a same-tenant admin read let a sergeant lift a new director's
    // temp password and sign in as them first. No client surface reads either
    // collection. A future admin mail log must go through a callable that
    // returns metadata only (to / subject / delivery state) — never the body.
    match /mail/{mailId} {
      allow read, write: if false; // functions/Admin SDK only
    }
    match /mailQueue/{mailId} {
      allow read, write: if false; // functions/Admin SDK only
    }

    // ── scheduleChangeQueue/{sessionId} — pending schedule-change notices ───
    // Server-owned (trigger + flush job). Staff read their org's entries so the
    // builder can show "notice queued" — DIRECT field compare (list-safe).
    match /scheduleChangeQueue/{sessionId} {
      allow read: if request.auth != null
        && request.auth.token.role in ['coordinator', 'sergeant', 'lieutenant', 'director']
        && request.auth.token.orgId != null
        && resource.data.orgId == request.auth.token.orgId;
      allow write: if false;
    }

    // ── bulkMessages ───────────────────────────────────────────────────────
    match /bulkMessages/{id} {
      allow read: if isStaff() && inOrg(resource.data);
      allow create: if isStaff()
        && request.resource.data.requestedBy == request.auth.uid
        && inOrg(request.resource.data)
        && request.resource.data.status == 'pending'
        // The fan-out escapes these as HTML AFTER claiming the message — a
        // non-string would crash it and strand the doc in 'sending'.
        && request.resource.data.subject is string
        && request.resource.data.body is string;
      allow update, delete: if false;
    }

    // ── auditLog ───────────────────────────────────────────────────────────
    // Append-only from STAFF clients (must stamp own uid + own org). Every client
    // logAudit() call site is a staff surface (members' sign-ups/withdrawals are
    // logged by the callables), so a plain member — or a not-yet-approved join,
    // whose token already carries the orgId — has no business writing here and
    // could otherwise fill the owner's audit trail with fabricated entries.
    match /auditLog/{logId} {
      // Owner-only read — matches the nav/route move (0e4ff7d); org admins
      // lost the page, so the raw collection shouldn't stay readable either.
      allow read: if isPlatformOwner() && inOrg(resource.data);
      allow create: if isStaff()
        && request.resource.data.actorUid == request.auth.uid
        && inOrg(request.resource.data);
      allow update, delete: if false;
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
